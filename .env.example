# ==============================================================================
# HERMES RESEARCH AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# 2-Researcher Discord Access Control (Mandatory Allowlist)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_target_discord_guild_id
USER1_ID=123456789012345678
USER2_ID=234567890123456789

# LLM Gateway (agentrouter.org, OpenAI, Anthropic, or local Ollama)
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=your_agentrouter_or_openai_api_key
LLM_MODEL=gpt-4o-mini

# Embedding & Reranking Pipeline
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-base

# Database (PostgreSQL 16 in Docker, or SQLite for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_hermes_pass@postgres:5432/hermes_research
# Local offline fallback: sqlite+aiosqlite:///./hermes_research.db

# Vector Database (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hermes_literature

# Object Storage (MinIO S3)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_hermes_admin
MINIO_SECRET_KEY=minio_hermes_secret_2026
MINIO_BUCKET_PAPERS=hermes-papers
MINIO_SECURE=false

# Task Queue & Message Broker (Redis 7)
REDIS_URL=redis://redis:6379/0

# Academic PDF Structure Extraction (GROBID)
GROBID_URL=http://grobid:8070

# Academic API Credentials & Rate-Limit Optimization
SEMANTIC_SCHOLAR_API_KEY=
NCBI_EMAIL=researcher@example.com
NCBI_API_KEY=
OPENALEX_EMAIL=researcher@example.com
